# Git: Negations (keep these tracked)
!.env.example
!.env.template
!.env.schema
!.dev.vars.example
!.changeset/README.md
!.changeset/config.json

# Git: Yarn PnP exceptions
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Git: Private keys (too broad for shared partial)
*.key

# Git: VS Code (keep config files)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Git: Local developer state (`.branding.*.yml`, `.devenv.json`,
# `branding-git-exclude`, `.playwright-mcp`, `.cocoindex_code/` all live in the
# shared partial — universal scanner ignore).
# `.foundation/*` (not `.foundation/`) so the negation
# below is honoured — git refuses to re-include children of an excluded
# directory, but re-including children of an excluded PATTERN works. Without
# this, `!.foundation/sync-manifest.json` silently does nothing
# and `git add .foundation/sync-manifest.json` needs -f.
.foundation/*

# Sync manifest is committed intentionally so template deletions surface as
# visible diffs in review (see sync/utils/manifest.ts).
!.foundation/sync-manifest.json

# The verdict writer at the end of `runLinter` emits one
# `<pkgDir>/.foundation/lint-verdict.json` per workspace package
# — read on every invocation by the cache-immune `lint-gate` stage. A
# pattern with a slash is anchored to this .gitignore's location, so the
# root-level rule above does NOT cover nested per-package directories;
# spell that out here.
**/.foundation/*

# `test-results/` (in the shared partial) targets test-OUTPUT dirs; re-include
# the first-party source "lens" directory that the broad pattern would otherwise
# ignore.
!packages/shared/ui/src/test-results/
!packages/shared/ui/src/test-results/**

# Keep the bootstrap script committed (`.mise/` is ignored via the shared
# partial; `bin/mise` is the entry point and must be tracked in git).
!bin/mise

# Lock files — DO NOT IGNORE
# pnpm-lock.yaml MUST be committed
!pnpm-lock.yaml

# typst docs build-check scratch
docs/*.pdf.tmp

# The operator-playbook PDFs are shipped deliverables (kept in sync by
# `npm run docs:check`), so they override the global *.pdf ignore above.
!docs/*.pdf

# playbook PDFs copied into the site at build time (source of truth is docs/)
packages/products/website/public/playbooks/

# The site's own icons/og images are committed (override the global *.png ignore).
!packages/products/website/public/**/*.png

# Playwright visual-regression baselines are committed test inputs (override *.png).
!packages/products/website/e2e/**/*.png

# ── copy-audit skill: force-vendored deps ──────────────────────────────────
# copy-audit is the one skill with npm/parser deps + tree-sitter grammar wasms. It ships
# vendored (turnkey for marketplace users) — re-include its node_modules + grammars, which
# the global node_modules/ and build-artifact rules above would otherwise ignore. The wasms
# are stored via git-lfs (see .gitattributes).
!plugins/ttt-workflows/skills/copy-audit/scripts/node_modules/
!plugins/ttt-workflows/skills/copy-audit/scripts/node_modules/**
!plugins/ttt-workflows/skills/copy-audit/scripts/grammars/
!plugins/ttt-workflows/skills/copy-audit/scripts/grammars/**
