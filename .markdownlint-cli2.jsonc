{
	// Lint EVERY authored markdown file in the repo — root docs, plugin/skill docs, reference
	// docs, and templates — not just the top level. Vendored, generated, and toolchain trees are
	// excluded. (Historically only "*.md" at the root was linted, so the skill reference docs went
	// unchecked; this closes that gap.)
	"globs": ["**/*.md"],
	"ignores": [
		"**/node_modules/**",
		"**/.pnpm/**",
		"**/scripts/grammars/**",
		"**/dist/**",
		"**/build/**",
		"**/coverage/**",
		"**/.astro/**",
		"**/.turbo/**",
		"**/.mise/**",
		"**/.git/**",
	],
	"config": {
		"MD013": false,
		"MD033": false,
		"MD041": false,
		// CHANGELOG.md repeats "### Features" / "### Bug Fixes" under each version (Keep a Changelog +
		// git-cliff); allow the same heading text under different parents.
		"MD024": { "siblings_only": true },
	},
}
