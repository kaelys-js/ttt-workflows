# pnpm config for the marketing site. Adapted from the resist-js house template.
# Note: pnpm 11 reads only auth/registry settings from .npmrc — the exact-pin,
# engine, supply-chain, and hoist settings live in pnpm-workspace.yaml.

# ============================================
# Performance & Caching
# ============================================
prefer-offline = true
fetch-retries = 3
fetch-retry-mintimeout = 10000
fetch-retry-maxtimeout = 60000

# ============================================
# Security
# ============================================
audit = true
audit-level = moderate

# ============================================
# Peer Dependencies
# ============================================
auto-install-peers = true
strict-peer-dependencies = false

# ============================================
# Network
# ============================================
network-concurrency = 16

# ============================================
# Hoisting
# ============================================
shamefully-hoist = false
public-hoist-pattern[] = *types*
public-hoist-pattern[] = *vite*
public-hoist-pattern[] = *prettier*

# ============================================
# Install Behaviour
# ============================================
prefer-frozen-lockfile = true
loglevel = warn
node-linker = isolated
package-import-method = hardlink
dedupe-peer-dependents = true
package-manager-strict = true

# ============================================
# Registry
# ============================================
strict-ssl = true
registry = https://registry.npmjs.org
verify-store-integrity = true
