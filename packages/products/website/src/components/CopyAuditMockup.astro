---
// A neutral recreation of a copy-audit run in Claude Code (no real repo, no real
// copy). Semantic tokens only, so it renders true light/dark with the rest of the
// page — no rasterized screenshot, no placeholder artifacts.
type Verdict = "rewrite" | "flag";
const dot: Record<Verdict, string> = {
	rewrite: "bg-[#e6a23c]",
	flag: "bg-muted-foreground/50",
};
type Finding =
	| { verdict: "rewrite"; category: string; before: string; after: string; at: string }
	| { verdict: "flag"; category: string; note: string; at: string };
const findings: Finding[] = [
	{
		verdict: "rewrite",
		category: "microcopy",
		before: "Click here to get started",
		after: "Get started",
		at: "hero.astro:12",
	},
	{
		verdict: "flag",
		category: "inclusive",
		note: '"sanity check" — needs a house-style call',
		at: "docs/setup.md:38",
	},
];
---

<div
	class="w-full max-w-md overflow-hidden rounded-2xl border border-border/60 bg-card shadow-2xl shadow-black/10 ring-1 ring-black/5 dark:shadow-black/40"
	role="img"
	aria-label="A copy-audit run in Claude Code: 142 copy units reviewed across four content pillars, with a keep, rewrite, and flag tally, one microcopy rewrite and one inclusive-language flag shown, read-only until you approve the rewrites."
>
	<div class="flex items-center gap-2 border-b border-border/60 px-4 py-3">
		<span class="size-3 rounded-full bg-[#ff5f57]"></span>
		<span class="size-3 rounded-full bg-[#febc2e]"></span>
		<span class="size-3 rounded-full bg-[#28c840]"></span>
		<span class="ml-2 text-xs font-medium text-muted-foreground">Claude Code · copy-audit</span>
	</div>

	<div class="px-5 py-4 font-mono text-[12px] leading-relaxed">
		<div class="text-muted-foreground">
			<span class="text-primary">❯</span> copy-audit acme/site --full
		</div>
	</div>

	<div class="border-t border-border/60 px-5 py-4">
		<div class="text-xs font-semibold text-muted-foreground">
			142 copy units reviewed · four pillars
		</div>
		<div class="mt-3 flex flex-wrap items-center gap-2 text-[12px]">
			<span class="inline-flex items-center gap-1.5">
				<span class="size-1.5 rounded-full bg-primary"></span>
				<span class="font-medium">128</span><span class="text-muted-foreground">keep</span>
			</span>
			<span class="text-border">·</span>
			<span class="inline-flex items-center gap-1.5">
				<span class="size-1.5 rounded-full bg-[#e6a23c]"></span>
				<span class="font-medium">9</span><span class="text-muted-foreground">rewrite</span>
			</span>
			<span class="text-border">·</span>
			<span class="inline-flex items-center gap-1.5">
				<span class="size-1.5 rounded-full bg-muted-foreground/50"></span>
				<span class="font-medium">5</span><span class="text-muted-foreground">flag</span>
			</span>
		</div>
	</div>

	<div class="border-t border-border/60 px-5 py-4">
		<ul class="space-y-3">
			{
				findings.map((f) => (
					<li class="flex items-start gap-2.5 text-[13px]">
						<span class={`mt-1.5 size-1.5 shrink-0 rounded-full ${dot[f.verdict]}`} />
						<div class="min-w-0 leading-snug">
							<span class="font-medium">{f.verdict}</span>
							<span class="text-muted-foreground"> · {f.category}</span>
							{f.verdict === "rewrite" ? (
								<div class="mt-0.5">
									<span class="text-muted-foreground line-through">{f.before}</span>
									<span class="text-muted-foreground"> → </span>
									<span class="font-medium">{f.after}</span>
								</div>
							) : (
								<div class="mt-0.5 text-muted-foreground">{f.note}</div>
							)}
							<div class="font-mono text-[11px] text-muted-foreground">{f.at}</div>
						</div>
					</li>
				))
			}
		</ul>
	</div>

	<div class="border-t border-border/60 px-5 py-3">
		<span class="text-xs text-muted-foreground"
			>Rewrites proposed — nothing is written until you approve.</span
		>
	</div>
</div>
