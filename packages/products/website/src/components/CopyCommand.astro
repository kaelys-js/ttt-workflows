---
// A plain server-rendered command row with a copy button — no framework, so it adds no JS to the
// initial load beyond one tiny shared handler. Both icons ship in the markup; the check swaps in
// via CSS while the button carries data-copied (set for COPIED_MS by wireCopyButtons on click).
import Icon from "@/components/ui/Icon.astro";

interface Props {
	cmd: string;
}
const { cmd } = Astro.props;
---

<div
	class="flex items-center justify-between gap-3 rounded-lg border bg-muted/50 px-4 py-3 font-mono text-sm"
>
	{
		/* min-w-0 lets the code shrink so a long command scrolls INSIDE the row instead of widening
	    the page (mobile); the right-edge mask fades the cutoff as a "there is more, scroll" cue.
	    tabindex=0 makes that scroll region keyboard-reachable (WCAG scrollable-region-focusable). */
	}
	<code
		tabindex="0"
		class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap text-foreground/90 [-webkit-mask-image:linear-gradient(to_right,#000_calc(100%-1.25rem),transparent)] [mask-image:linear-gradient(to_right,#000_calc(100%-1.25rem),transparent)]"
		>{cmd}</code
	>
	{/* The two icons overlap and crossfade via opacity, so the swap animates in BOTH directions. */}
	<button
		type="button"
		data-copy={cmd}
		aria-label="Copy command"
		class="group relative grid shrink-0 place-items-center rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground cursor-pointer"
	>
		<Icon
			name="copy"
			class="col-start-1 row-start-1 size-4 transition-opacity duration-200 group-data-[copied]:opacity-0"
		/>
		<Icon
			name="check"
			class="col-start-1 row-start-1 size-4 text-primary opacity-0 transition-opacity duration-200 group-data-[copied]:opacity-100"
		/>
	</button>
</div>

<script>
	import { wireCopyButtons } from "@/lib/copy";
	wireCopyButtons();
</script>
