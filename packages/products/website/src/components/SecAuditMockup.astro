---
// A neutral recreation of a sec-audit sweep in Claude Code (no real tenant, no real
// finding). Semantic tokens only, so it renders true light/dark — no rasterized
// screenshot, no placeholder artifacts.
const layers = [
	{ name: "Source / IaC", tools: "semgrep · gitleaks · osv · checkov" },
	{ name: "Live Azure", tools: "firewall · TLS floor · Key Vault" },
	{ name: "Entra / ADO", tools: "app-regs · pipeline secrets" },
];
---

<div
	class="w-full max-w-md overflow-hidden rounded-2xl border border-border/60 bg-card shadow-2xl shadow-black/10 ring-1 ring-black/5 dark:shadow-black/40"
	role="img"
	aria-label="sec-audit sweeps three layers — code and infrastructure, live Azure, and identity and CI — and drafts one high-severity finding as a private advisory, read-only until disclosure is approved."
>
	<div class="flex items-center gap-2 border-b border-border/60 px-4 py-3">
		<span class="size-3 rounded-full bg-[#ff5f57]"></span>
		<span class="size-3 rounded-full bg-[#febc2e]"></span>
		<span class="size-3 rounded-full bg-[#28c840]"></span>
		<span class="ml-2 text-xs font-medium text-muted-foreground">Claude Code · sec-audit</span>
	</div>

	<div class="px-5 py-4 font-mono text-[12px] leading-relaxed">
		<div class="text-muted-foreground">
			<span class="text-primary">❯</span> sec-audit sweep acme/infra
		</div>
	</div>

	<div class="border-t border-border/60 px-5 py-4">
		<div class="text-xs font-semibold text-muted-foreground">Three layers swept</div>
		<ul class="mt-3 space-y-2.5">
			{
				layers.map((l) => (
					<li class="flex items-center gap-2.5 text-[13px]">
						<span class="size-1.5 shrink-0 rounded-full bg-primary" />
						<span class="w-28 shrink-0 font-medium">{l.name}</span>
						<span class="truncate font-mono text-[11px] text-muted-foreground">{l.tools}</span>
					</li>
				))
			}
		</ul>
	</div>

	<div class="border-t border-border/60 px-5 py-4">
		<div class="flex items-center gap-2 text-[13px]">
			<span
				class="rounded-md bg-[#e5484d]/12 px-1.5 py-0.5 text-[11px] font-semibold text-[#b3242b] dark:text-[#ff9ea3]"
				>High</span
			>
			<span class="font-mono text-[11px] text-muted-foreground">SEC-07 · CVSS 8.2</span>
		</div>
		<p class="mt-2 text-[13px] leading-snug">
			Postgres reachable from <span class="font-mono">0.0.0.0</span> — public network access enabled.
		</p>
	</div>

	<div class="border-t border-border/60 px-5 py-3">
		<span class="text-xs text-muted-foreground"
			>Private advisory drafted. Read-only until you approve disclosure.</span
		>
	</div>
</div>
