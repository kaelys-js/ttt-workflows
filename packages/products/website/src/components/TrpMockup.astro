---
// A neutral recreation of a trp run in Claude Code, stopped at the approval gate
// (no real ticket, no real repo). Semantic tokens only, so it renders true
// light/dark — no rasterized screenshot, no placeholder artifacts.
const plan = [
	{ done: true, text: "Grounded in the repo — auth.middleware.ts:44, no limiter mounted" },
	{ done: false, text: "Change: mount the limiter, add a regression test" },
	{ done: false, text: "Verify: format · lint · affected tests · build — all green" },
	{ done: false, text: "PR opened on GitHub; ticket updated in both layers" },
];
---

<div
	class="w-full max-w-md overflow-hidden rounded-2xl border border-border/60 bg-card shadow-2xl shadow-black/10 ring-1 ring-black/5 dark:shadow-black/40"
	role="img"
	aria-label="A trp run in Claude Code, stopped at the approval gate: the ticket is grounded in the repo and a full plan is presented, but nothing runs until a human approves."
>
	<div class="flex items-center gap-2 border-b border-border/60 px-4 py-3">
		<span class="size-3 rounded-full bg-[#ff5f57]"></span>
		<span class="size-3 rounded-full bg-[#febc2e]"></span>
		<span class="size-3 rounded-full bg-[#28c840]"></span>
		<span class="ml-2 text-xs font-medium text-muted-foreground">Claude Code · trp</span>
	</div>

	<div class="px-5 py-4 font-mono text-[12px] leading-relaxed">
		<div class="text-muted-foreground">
			<span class="text-primary">❯</span> trp CU-8x9k2 · Add a rate limit to /login
		</div>
	</div>

	<div class="border-t border-border/60 px-5 py-4">
		<div class="text-xs font-semibold text-muted-foreground">Plan · phases 0–5</div>
		<ul class="mt-3 space-y-2.5">
			{
				plan.map((p) => (
					<li class="flex items-start gap-2.5 text-[13px]">
						{p.done ? (
							<svg
								viewBox="0 0 24 24"
								class="mt-0.5 size-4 shrink-0 text-primary"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M20 6 9 17l-5-5" />
							</svg>
						) : (
							<span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-muted-foreground/40" />
						)}
						<span class="leading-snug">{p.text}</span>
					</li>
				))
			}
		</ul>
	</div>

	<div class="flex items-center justify-between border-t border-border/60 px-5 py-4">
		<span class="text-xs text-muted-foreground">Waiting — nothing runs until you say go.</span>
		<div class="flex items-center gap-2" aria-hidden="true">
			<span class="rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground"
				>Revise</span
			>
			<span class="rounded-md bg-primary px-3 py-1 text-xs font-medium text-primary-foreground"
				>Approve</span
			>
		</div>
	</div>
</div>
