---
import Layout from "@/layouts/Layout.astro";
import PrReviewMockup from "@/components/PrReviewMockup.astro";
import SkillDemo from "@/components/SkillDemo.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import GithubButton from "@/components/GithubButton.astro";
import GithubMark from "@/components/GithubMark.astro";
import Faq from "@/components/Faq.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import Card from "@/components/ui/Card.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import Badge from "@/components/ui/Badge.astro";
import Icon from "@/components/ui/Icon.astro";

import * as v from "valibot";
import {
	DemosSchema,
	parseVersion,
	PlaybooksSchema,
	SkillsSchema,
	StepsSchema,
} from "@/lib/schemas";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const REPO = "https://github.com/kaelys-js/ttt-workflows";
// Shown in the footer, in lockstep with the release tag (build-injected). Empty off a tag.
const appVersion = parseVersion(import.meta.env.PUBLIC_APP_VERSION);
const MARKETPLACE_ADD = "/plugin marketplace add kaelys-js/ttt-workflows";
const PLUGIN_INSTALL = "/plugin install ttt-workflows";

const skills = v.parse(SkillsSchema, [
	{
		icon: "git-pull-request",
		name: "pr-review",
		cmd: "/pr-review",
		does: "Give it a GitHub or Azure DevOps pull-request URL. It reviews the diff — design and correctness first — checks every finding against the code, and labels each by severity. It drops weak findings before returning the review, so what you get is worth acting on.",
		tags: ["design", "correctness", "security", "tests"],
		produces:
			"One review you can paste straight into the PR: a verdict up top, a table of findings you can scan in seconds, and a concrete fix for each.",
		boundary: "Read-only",
		boundaryNote: "Never posts, comments, approves, or merges. You paste the result.",
	},
	{
		icon: "shield-check",
		name: "sec-audit",
		cmd: "/sec-audit",
		does: "Audits a repo, a PR, a path, or your live Azure, Entra, and Azure DevOps. It looks where vulnerabilities hide — the code and its infrastructure, the running cloud, and who can reach it. Four modes take a finding from discovery to a fix.",
		tags: ["sweep", "review", "poc", "remediate"],
		produces:
			"Scored findings (CVSS 4.0 and CWE), a private advisory for each, a proof-of-concept you can reproduce and throw away, and a report that lists what was and was not covered.",
		boundary: "Approval-gated",
		boundaryNote: "Read-only until you approve. A fix is a PR opened, never merged.",
	},
	{
		icon: "clipboard-check",
		name: "trp",
		cmd: "/trp",
		does: "Takes a ticket from assigned to merged. It grounds the work in your code, presents a full plan, and stops for your approval. Once you approve, it implements, runs the gates (format, lint, affected tests, build), and opens the PR.",
		tags: ["ground", "plan", "build", "verify", "ship"],
		produces:
			"A merge-ready PR that meets the acceptance criteria, plus a two-layer ticket update for the business and for engineers.",
		boundary: "Approval-gated",
		boundaryNote: "Waits for your approval. No branch and no write happen before you approve.",
	},
	{
		icon: "file-text",
		name: "copy-audit",
		cmd: "/copy-audit",
		does: "Point it at a repo or a diff and it audits the words: UI microcopy, docs, markdown prose, JSON and YAML copy. Parallel reviewers judge each string in its full-file context against four content pillars. In comment mode, it turns the same lens on code-comment slop and test names.",
		tags: ["plain-language", "inclusive", "microcopy", "voice"],
		produces:
			"A reviewed set of verdicts — keep, rewrite, flag, delete — with the exact rewrite for each. Applying one splices only the text, so a verify pass can prove not a single line of code moved.",
		boundary: "Approval-gated",
		boundaryNote: "Reads and proposes. Nothing is written to disk until you approve the rewrites.",
	},
]);

const steps = v.parse(StepsSchema, [
	{
		n: "1",
		title: "Add the marketplace",
		body: "Point Claude Code at the git-backed marketplace once. It stays available for every project.",
		cmd: MARKETPLACE_ADD,
	},
	{
		n: "2",
		title: "Install the plugin",
		body: "Install ttt-workflows and all four skills register at once. Nothing else to set up.",
		cmd: PLUGIN_INSTALL,
	},
]);

const playbooks = v.parse(PlaybooksSchema, [
	{
		slug: "pr-review",
		name: "PR Review",
		body: "Read every changed line, prove what you find, and hand back one review that lands in a single round. How to do a senior PR review by hand.",
	},
	{
		slug: "sec-audit",
		name: "Security Audit",
		body: "Look in all three places a vulnerability hides, prove what you find, and never touch a live system until it is approved. The full manual method.",
	},
	{
		slug: "trp",
		name: "Task Resolution Protocol",
		body: "Take a ticket from assigned to merged: ground it in the code, get the plan approved, then build, prove, and close it out.",
	},
	{
		slug: "copy-audit",
		name: "Copy Audit",
		body: "Read every string a repo ships, judge it against the four content pillars, and rewrite only the words — never the code around them. How to do a copy review by hand.",
	},
]);

// A short, synthetic run of each skill, played as an animated terminal transcript (SkillDemo).
// No real repo, tenant, or ticket — every value is invented, so the demos stay agnostic. Each
// mirrors its skill card, so the demo and the card read as one system. Validated at build.
const demos = v.parse(DemosSchema, [
	{
		skill: "pr-review",
		cmd: "/pr-review github.com/acme/api/pull/482",
		caption:
			"pr-review reads the diff, proves each finding, and hands back one paste-ready review.",
		aria: "pr-review returns a request-changes verdict — one blocking and two non-blocking findings, each anchored to a file and line — as a paste-ready comment.",
		lines: [
			{ kind: "stream", text: "Reading the diff — 6 files, +214 −38 …" },
			{ kind: "stream", text: "Checking each finding against the code …" },
			{
				kind: "verdict",
				tone: "danger",
				label: "Request changes",
				tail: "· 1 blocking, 2 non-blocking",
			},
			{
				kind: "item",
				dot: "danger",
				label: "issue",
				text: "— PATCH /users/:id has no object-level authz",
				at: "users.controller.ts:88",
			},
			{
				kind: "item",
				dot: "warn",
				label: "suggestion",
				text: "— Empty string slips past the filter, widening the query",
				at: "repo.ts:41",
			},
			{
				kind: "item",
				dot: "muted",
				label: "nitpick",
				text: "— Comment restates the code instead of the why",
				at: "token.ts:12",
			},
			{ kind: "footer", text: "Nothing posted — the review is handed back for you to paste." },
		],
	},
	{
		skill: "sec-audit",
		cmd: "/sec-audit sweep acme/infra",
		caption: "sec-audit sweeps all three layers and scores what it finds.",
		aria: "sec-audit sweeps three layers — code and infrastructure, live Azure, and identity and CI — and drafts one high-severity finding as a private advisory, read-only until disclosure is approved.",
		lines: [
			{ kind: "stream", text: "Sweeping source & IaC, live Azure, identity & CI …" },
			{ kind: "heading", text: "Three layers swept" },
			{
				kind: "item",
				dot: "primary",
				label: "Source / IaC",
				text: "— semgrep · gitleaks · osv · checkov",
			},
			{
				kind: "item",
				dot: "primary",
				label: "Live Azure",
				text: "— firewall · TLS floor · Key Vault",
			},
			{ kind: "item", dot: "primary", label: "Entra / ADO", text: "— app-regs · pipeline secrets" },
			{ kind: "verdict", tone: "danger", label: "High", tail: "· SEC-07 · CVSS 8.2" },
			{ kind: "item", text: "Postgres reachable from 0.0.0.0 — public network access enabled." },
			{ kind: "footer", text: "Private advisory drafted. Read-only until you approve disclosure." },
		],
	},
	{
		skill: "trp",
		cmd: "/trp ClickUp CU-8x9k2 · Add a rate limit to /login",
		caption: "trp presents the plan and stops. The approval gate is absolute.",
		aria: "trp stops at the approval gate: the ticket is grounded in the repo and a full plan is shown, but nothing runs until you approve.",
		lines: [
			{ kind: "stream", text: "Grounding the ticket in the repo …" },
			{ kind: "heading", text: "Plan · phases 0–5" },
			{
				kind: "item",
				dot: "check",
				text: "Found in the repo — auth.middleware.ts:44, no rate limiter mounted",
			},
			{ kind: "item", dot: "muted", text: "Change: mount the limiter, add a regression test" },
			{
				kind: "item",
				dot: "muted",
				text: "Verify: format · lint · affected tests · build — all green",
			},
			{ kind: "item", dot: "muted", text: "PR opened on GitHub; ticket updated in both layers" },
			{ kind: "footer", text: "Waiting for your approval before anything runs." },
		],
	},
	{
		skill: "copy-audit",
		cmd: "/copy-audit acme/site --full",
		caption: "copy-audit weighs every string and rewrites only the words.",
		aria: "copy-audit reviews 142 strings across four content pillars and shows one proposed rewrite and one flag; nothing is applied until you approve.",
		lines: [
			{ kind: "stream", text: "Extracting strings, judging each in full-file context …" },
			{ kind: "heading", text: "142 strings reviewed · four content pillars" },
			{ kind: "stream", text: "128 keep · 9 rewrite · 5 flag" },
			{
				kind: "item",
				dot: "warn",
				label: "rewrite",
				text: '· microcopy — "Click here to get started" → "Get started"',
				at: "hero.astro:12",
			},
			{
				kind: "item",
				dot: "muted",
				label: "flag",
				text: '· inclusive — "sanity check" needs a house-style call',
				at: "docs/setup.md:38",
			},
			{ kind: "footer", text: "Rewrites proposed — nothing is written until you approve." },
		],
	},
]);
---

<Layout>
	<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
		<div
			class="absolute -top-40 left-1/2 h-[36rem] w-[72rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"
		>
		</div>
		<div
			class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,var(--color-border)_1px,transparent_0)] [background-size:26px_26px] opacity-40"
		>
		</div>
	</div>

	<header
		class="sticky top-0 z-40 border-b border-border/60 bg-background/70 backdrop-blur-xl [-webkit-backdrop-filter:blur(24px)]"
	>
		<nav aria-label="Main" class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-5">
			<a
				href="#main"
				class="flex items-center gap-2.5 font-semibold"
				aria-label="ttt-workflows, home"
			>
				<span
					class="grid size-8 place-items-center rounded-lg bg-gradient-to-br from-[#1eafd0] to-[#0c81b3] text-white"
				>
					<svg
						viewBox="0 0 24 24"
						class="size-5"
						fill="none"
						stroke="currentColor"
						stroke-width="2.4"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"><path d="M7 8l4 4-4 4"></path><path d="M13 16h5"></path></svg
					>
				</span>
				<span class="font-mono">ttt-workflows</span>
			</a>
			<div class="ml-auto hidden items-center gap-7 text-sm text-muted-foreground md:flex">
				<a href="#skills" class="transition-colors hover:text-foreground">Skills</a>
				<a href="#install" class="transition-colors hover:text-foreground">Install</a>
				<a href="#playbooks" class="transition-colors hover:text-foreground">Playbooks</a>
				<a href="#faq" class="transition-colors hover:text-foreground">FAQ</a>
			</div>
			<div class="ml-auto flex items-center gap-2 md:ml-6">
				<a
					href={REPO}
					target="_blank"
					rel="noopener noreferrer"
					class="grid size-9 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
					aria-label="View on GitHub (opens in a new tab)"><GithubMark class="size-5" /></a
				>
				<ThemeToggle />
				<a
					href="#install"
					class="hidden h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 sm:inline-flex"
					>Install</a
				>
			</div>
		</nav>
	</header>

	<main id="main">
		<section
			class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-5 py-16 md:py-24 lg:grid-cols-2"
		>
			<!-- Hero entrance: the LCP headline animates transform-only (data-hero="lcp",
			     never opacity:0) so LCP stays fast; the rest fade+rise with a light stagger. -->
			<div>
				<span data-hero class="inline-block">
					<Badge class="border-primary/20 bg-primary/10 text-primary"
						><Icon name="sparkles" class="size-3.5" /> Open source · Claude Code plugin</Badge
					>
				</span>
				<h1
					data-hero="lcp"
					class="mt-5 text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl"
				>
					Four engineering skills, <span
						class="bg-gradient-to-r from-[#1fb2d4] to-[#0c81b3] bg-clip-text text-transparent"
						>one plugin.</span
					>
				</h1>
				<p
					data-hero
					style="--hd:120ms"
					class="mt-5 max-w-xl text-lg text-muted-foreground text-pretty"
				>
					ttt-workflows bundles <span class="font-mono text-foreground/80">pr-review</span>, <span
						class="font-mono text-foreground/80">sec-audit</span
					>, <span class="font-mono text-foreground/80">trp</span>, and <span
						class="font-mono text-foreground/80">copy-audit</span
					>: four self-contained skills that review a pull request, run a security audit, deliver a
					ticket, or audit the copy end to end, from inside Claude Code. Read-only by default;
					anything that writes waits for your approval.
				</p>
				<div data-hero style="--hd:200ms" class="mt-8 max-w-xl space-y-3">
					<CopyCommand cmd={MARKETPLACE_ADD} />
					<CopyCommand cmd={PLUGIN_INSTALL} />
				</div>
				<div data-hero style="--hd:240ms" class="mt-5 flex flex-wrap items-center gap-3">
					<a href="#install" class="text-sm font-medium text-primary hover:underline"
						>How it works <span aria-hidden="true">↓</span></a
					>
					<span class="text-sm text-muted-foreground">·</span>
					<a
						href={REPO}
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm text-muted-foreground transition-colors hover:text-foreground"
						>View on GitHub<span class="sr-only"> (opens in a new tab)</span></a
					>
				</div>
			</div>
			<div data-hero style="--hd:140ms" class="flex justify-center lg:justify-end">
				<PrReviewMockup />
			</div>
		</section>

		<section id="trust" class="border-y border-border/60 bg-muted/30">
			<div
				class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-4 px-5 py-6 text-sm text-muted-foreground"
			>
				<span class="inline-flex items-center gap-2"
					><Icon name="eye" class="size-4 text-primary" /> Read-only by default</span
				>
				<span class="inline-flex items-center gap-2"
					><Icon name="shield-check" class="size-4 text-primary" /> Writes are approval-gated</span
				>
				<span class="inline-flex items-center gap-2"
					><Icon name="git-branch" class="size-4 text-primary" /> Any repo, any tenant</span
				>
				<span class="inline-flex items-center gap-2"
					><GithubMark class="size-4 text-primary" /> Open source</span
				>
			</div>
		</section>

		<section id="skills" class="mx-auto max-w-6xl px-5 py-20">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>Four skills</h2>
				<p class="mt-3 text-muted-foreground">
					Each is self-contained and portable across any repo and any tenant, with no client data
					baked in.
				</p>
			</div>
			<!-- Each card is a subgrid spanning the 5 shared row tracks (header / description:1fr /
			     tags / produces / boundary), so those sections line up across all four cards
			     regardless of copy length; the 1fr description row absorbs the difference. Two-up on
			     tablet, four-up on desktop. -->
			<div
				class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[auto_1fr_auto_auto_auto] lg:gap-y-4"
				data-stagger
			>
				{
					skills.map((s) => (
						<Card class="gap-4 transition-shadow hover:shadow-md lg:grid! lg:grid-rows-subgrid lg:row-span-5">
							<div class="flex items-center gap-3">
								<div class="grid size-10 place-items-center rounded-lg bg-primary/10 text-primary">
									<Icon name={s.icon} class="size-5" />
								</div>
								<div class="leading-tight">
									<CardTitle class="font-mono text-base">{s.name}</CardTitle>
									<code class="text-xs text-muted-foreground">{s.cmd}</code>
								</div>
							</div>
							<CardDescription class="leading-relaxed">{s.does}</CardDescription>
							<div class="flex flex-wrap gap-1.5">
								{s.tags.map((t) => (
									<span class="rounded border border-border/70 bg-muted/40 px-1.5 py-0.5 font-mono text-[11px] text-muted-foreground">
										{t}
									</span>
								))}
							</div>
							<div class="text-[13px] leading-relaxed">
								<span class="font-medium text-foreground">What it produces </span>
								<span class="text-muted-foreground">{s.produces}</span>
							</div>
							<div class="flex items-start gap-2 border-t border-border/60 pt-4">
								<span class="shrink-0 rounded-md bg-primary/10 px-2 py-0.5 text-[11px] font-semibold text-primary">
									{s.boundary}
								</span>
								<span class="text-[12px] leading-snug text-muted-foreground">{s.boundaryNote}</span>
							</div>
						</Card>
					))
				}
			</div>
		</section>

		<section id="install" class="border-y border-border/60 bg-muted/30">
			<div class="mx-auto max-w-6xl px-5 py-20">
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>Install once</h2>
					<p class="mt-3 text-muted-foreground">
						Two commands in Claude Code, then invoke a skill whenever you need it.
					</p>
				</div>
				<div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2" data-stagger>
					{
						steps.map((s) => (
							<div class="flex h-full flex-col">
								<div class="flex items-center gap-3">
									<div class="grid size-9 place-items-center rounded-full bg-primary text-sm font-bold text-primary-foreground">
										{s.n}
									</div>
									<h3 class="text-lg font-semibold">{s.title}</h3>
								</div>
								<p class="mt-3 text-sm leading-relaxed text-muted-foreground">{s.body}</p>
								<div class="mt-auto pt-5">
									<CopyCommand cmd={s.cmd} />
								</div>
							</div>
						))
					}
				</div>
				<div class="mx-auto mt-12 max-w-3xl rounded-2xl border border-border/60 bg-card p-6 sm:p-8">
					<div class="flex items-center gap-2 text-sm font-semibold">
						<Icon name="terminal" class="size-4 text-primary" /> Then invoke a skill
					</div>
					<ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted-foreground">
						<li class="grid grid-cols-[7rem_1fr] items-baseline gap-x-3 gap-y-1 max-sm:grid-cols-1">
							<code class="font-mono text-foreground/90">/pr-review</code>
							<span>Paste a pull-request URL and ask for a review.</span>
						</li>
						<li class="grid grid-cols-[7rem_1fr] items-baseline gap-x-3 gap-y-1 max-sm:grid-cols-1">
							<code class="font-mono text-foreground/90">/sec-audit</code>
							<span>
								Point it at a repo, a PR, a path, or a live tenant, and name a mode: sweep, review,
								poc, or remediate.
							</span>
						</li>
						<li class="grid grid-cols-[7rem_1fr] items-baseline gap-x-3 gap-y-1 max-sm:grid-cols-1">
							<code class="font-mono text-foreground/90">/trp</code>
							<span
								>Hand it a ticket URL; it grounds the work, presents a plan, and stops for approval.</span
							>
						</li>
						<li class="grid grid-cols-[7rem_1fr] items-baseline gap-x-3 gap-y-1 max-sm:grid-cols-1">
							<code class="font-mono text-foreground/90">/copy-audit</code>
							<span>
								Point it at a repo or a diff for a copy and microcopy pass; add <code
									class="font-mono text-foreground/90">--mode=comments</code
								> to sweep code comments and test names.
							</span>
						</li>
					</ul>
				</div>
			</div>
		</section>

		<section id="in-action" class="mx-auto max-w-6xl px-5 py-20">
			<div class="mx-auto max-w-2xl text-center">
				<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>
					Watch each skill run
				</h2>
				<p class="mt-3 text-muted-foreground">
					A short, synthetic run of each skill, played inside a Claude Code session — the same
					transcript, with motion off.
				</p>
			</div>
			<div
				class="mx-auto mt-12 grid max-w-4xl grid-cols-1 items-start justify-items-center gap-8 sm:grid-cols-2"
			>
				{demos.map((demo) => <SkillDemo demo={demo} />)}
			</div>
		</section>

		<section id="playbooks" class="border-y border-border/60 bg-muted/30">
			<div class="mx-auto max-w-6xl px-5 py-20">
				<div class="mx-auto max-w-2xl text-center">
					<h2 class="text-3xl font-bold tracking-tight sm:text-4xl" data-reveal>
						Operator's playbooks
					</h2>
					<p class="mt-3 text-muted-foreground">
						Each skill ships a companion PDF: the what, how, and why of doing that work by hand.
					</p>
				</div>
				<div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
					{
						playbooks.map((p) => (
							<Card class="gap-3 transition-shadow hover:shadow-md">
								<div class="grid size-10 place-items-center rounded-lg bg-primary/10 text-primary">
									<Icon name="file-text" class="size-5" />
								</div>
								<CardTitle class="text-base">{p.name}</CardTitle>
								<CardDescription class="leading-relaxed">{p.body}</CardDescription>
								<a
									href={`${base}/playbooks/${p.slug}.pdf`}
