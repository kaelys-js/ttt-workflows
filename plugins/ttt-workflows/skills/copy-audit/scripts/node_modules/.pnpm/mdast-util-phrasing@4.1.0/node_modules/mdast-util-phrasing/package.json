{
	"name": "mdast-util-phrasing",
	"version": "4.1.0",
	"description": "mdast utility to check if a node is phrasing content",
	"keywords": [
		"markdown",
		"mdast",
		"mdast=util",
		"phrasing",
		"unist",
		"util",
		"utility"
	],
	"bugs": "https://github.com/syntax-tree/mdast-util-phrasing/issues",
	"license": "MIT",
	"author": "Victor Felder <victor@draft.li> (https://draft.li)",
	"contributors": [
		"Victor Felder <victor@draft.li> (https://draft.li)",
		"Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)"
	],
	"repository": "syntax-tree/mdast-util-phrasing",
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/unified"
	},
	"files": [
		"lib/",
		"index.d.ts",
		"index.js"
	],
	"type": "module",
	"sideEffects": false,
	"exports": "./index.js",
	"scripts": {
		"prepack": "npm run build && npm run format",
		"build": "tsc --build --clean && tsc --build && type-coverage",
		"format": "remark . -qfo && prettier . -w --log-level warn && xo --fix",
		"test-api": "node --conditions development test.js",
		"test-coverage": "c8 --100 --reporter lcov npm run test-api",
		"test": "npm run build && npm run format && npm run test-coverage"
	},
	"dependencies": {
		"@types/mdast": "^4.0.0",
		"unist-util-is": "^6.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"c8": "^9.0.0",
		"prettier": "^3.0.0",
		"remark-cli": "^11.0.0",
		"remark-preset-wooorm": "^9.0.0",
		"type-coverage": "^2.0.0",
		"typescript": "^5.0.0",
		"xo": "^0.56.0"
	},
	"xo": {
		"prettier": true
	},
	"prettier": {
		"bracketSpacing": false,
		"semi": false,
		"singleQuote": true,
		"tabWidth": 2,
		"trailingComma": "none",
		"useTabs": false
	},
	"remarkConfig": {
		"plugins": [
			"remark-preset-wooorm"
		]
	},
	"typeCoverage": {
		"atLeast": 100,
		"detail": true,
		"ignoreCatch": true,
		"strict": true
	}
}
