{
	"name": "micromark-extension-gfm-strikethrough",
	"version": "2.1.0",
	"description": "micromark extension to support GFM strikethrough",
	"keywords": [
		"del",
		"delete",
		"deletion",
		"gfm",
		"markdown",
		"micromark",
		"micromark-extension",
		"strike",
		"strikethrough",
		"through",
		"unified"
	],
	"bugs": "https://github.com/micromark/micromark-extension-gfm-strikethrough/issues",
	"license": "MIT",
	"author": "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
	"contributors": [
		"Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)"
	],
	"repository": "micromark/micromark-extension-gfm-strikethrough",
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/unified"
	},
	"files": [
		"dev/",
		"lib/",
		"index.d.ts",
		"index.js"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"development": "./dev/index.js",
		"default": "./index.js"
	},
	"scripts": {
		"prepack": "npm run build && npm run format",
		"build": "tsc --build --clean && tsc --build && type-coverage && micromark-build",
		"format": "remark . -qfo && prettier . -w --log-level warn && xo --fix",
		"test-api-prod": "node --conditions production test/index.js",
		"test-api-dev": "node --conditions development test/index.js",
		"test-api": "npm run test-api-dev && npm run test-api-prod",
		"test-coverage": "c8 --100 --reporter lcov npm run test-api",
		"test": "npm run build && npm run format && npm run test-coverage"
	},
	"dependencies": {
		"devlop": "^1.0.0",
		"micromark-util-chunked": "^2.0.0",
		"micromark-util-classify-character": "^2.0.0",
		"micromark-util-resolve-all": "^2.0.0",
		"micromark-util-symbol": "^2.0.0",
		"micromark-util-types": "^2.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"c8": "^10.0.0",
		"create-gfm-fixtures": "^1.0.0",
		"micromark": "^4.0.0",
		"micromark-build": "^2.0.0",
		"prettier": "^3.0.0",
		"remark-cli": "^12.0.0",
		"remark-preset-wooorm": "^10.0.0",
		"tape": "^5.0.0",
		"type-coverage": "^2.0.0",
		"typescript": "^5.0.0",
		"xo": "^0.58.0"
	},
	"xo": {
		"overrides": [
			{
				"files": "**/*.ts",
				"rules": {
					"@typescript-eslint/array-type": [
						"error",
						{
							"default": "generic"
						}
					],
					"@typescript-eslint/ban-types": [
						"error",
						{
							"extendDefaults": true
						}
					],
					"@typescript-eslint/consistent-type-definitions": [
						"error",
						"interface"
					]
				}
			},
			{
				"files": "test/**/*.js",
				"rules": {
					"no-await-in-loop": 0
				}
			}
		],
		"prettier": true,
		"rules": {
			"logical-assignment-operators": "off",
			"max-depth": "off",
			"unicorn/prefer-at": "off"
		}
	},
	"prettier": {
		"bracketSpacing": false,
		"semi": false,
		"singleQuote": true,
		"tabWidth": 2,
		"trailingComma": "none",
		"useTabs": false
	},
	"remarkConfig": {
		"plugins": [
			"remark-preset-wooorm"
		]
	},
	"typeCoverage": {
		"atLeast": 100,
		"detail": true,
		"ignoreCatch": true,
		"strict": true
	}
}
