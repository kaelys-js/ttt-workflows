{
	"name": "ms",
	"version": "2.1.3",
	"description": "Tiny millisecond conversion utility",
	"license": "MIT",
	"repository": "vercel/ms",
	"files": [
		"index.js"
	],
	"main": "./index",
	"scripts": {
		"precommit": "lint-staged",
		"lint": "eslint lib/* bin/*",
		"test": "mocha tests.js"
	},
	"devDependencies": {
		"eslint": "4.18.2",
		"expect.js": "0.3.1",
		"husky": "0.14.3",
		"lint-staged": "5.0.0",
		"mocha": "4.0.1",
		"prettier": "2.0.5"
	},
	"lint-staged": {
		"*.js": [
			"npm run lint",
			"prettier --single-quote --write",
			"git add"
		]
	},
	"eslintConfig": {
		"env": {
			"es6": true,
			"node": true
		},
		"extends": "eslint:recommended"
	}
}
