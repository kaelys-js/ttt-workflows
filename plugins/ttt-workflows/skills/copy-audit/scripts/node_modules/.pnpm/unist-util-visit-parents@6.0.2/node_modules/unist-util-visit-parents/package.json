{
	"name": "unist-util-visit-parents",
	"version": "6.0.2",
	"description": "unist utility to recursively walk over nodes, with ancestral information",
	"keywords": [
		"ast",
		"check",
		"parent",
		"parents",
		"traverse",
		"tree",
		"unist",
		"unist-util",
		"util",
		"utility",
		"visit",
		"walk"
	],
	"bugs": "https://github.com/syntax-tree/unist-util-visit-parents/issues",
	"license": "MIT",
	"author": "Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)",
	"contributors": [
		"Titus Wormer <tituswormer@gmail.com> (https://wooorm.com)"
	],
	"repository": "syntax-tree/unist-util-visit-parents",
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/unified"
	},
	"files": [
		"lib/",
		"index.d.ts.map",
		"index.d.ts",
		"index.js"
	],
	"type": "module",
	"sideEffects": false,
	"types": "index.d.ts",
	"exports": {
		".": "./index.js",
		"./do-not-use-color": {
			"node": "./lib/color.node.js",
			"default": "./lib/color.js"
		}
	},
	"scripts": {
		"prepack": "npm run build && npm run format",
		"build": "tsc --build --clean && tsc --build && tsd && type-coverage",
		"format": "remark . -qfo && prettier . -w --log-level warn && xo --fix",
		"test-api": "node --conditions development test.js",
		"test-coverage": "c8 --100 --reporter lcov npm run test-api",
		"test": "npm run build && npm run format && npm run test-coverage"
	},
	"dependencies": {
		"@types/unist": "^3.0.0",
		"unist-util-is": "^6.0.0"
	},
	"devDependencies": {
		"@types/hast": "^3.0.0",
		"@types/mdast": "^4.0.0",
		"@types/node": "^24.0.0",
		"@types/xast": "^2.0.0",
		"c8": "^10.0.0",
		"mdast-util-from-markdown": "^2.0.0",
		"mdast-util-gfm": "^3.0.0",
		"micromark-extension-gfm": "^3.0.0",
		"prettier": "^3.0.0",
		"remark-cli": "^12.0.0",
		"remark-preset-wooorm": "^10.0.0",
		"strip-ansi": "^7.0.0",
		"tsd": "^0.33.0",
		"type-coverage": "^2.0.0",
		"typescript": "^5.0.0",
		"xo": "^0.58.0"
	},
	"xo": {
		"prettier": true,
		"rules": {
			"unicorn/prefer-at": "off",
			"unicorn/prefer-string-replace-all": "off"
		}
	},
	"prettier": {
		"bracketSpacing": false,
		"semi": false,
		"singleQuote": true,
		"tabWidth": 2,
		"trailingComma": "none",
		"useTabs": false
	},
	"remarkConfig": {
		"plugins": [
			"remark-preset-wooorm"
		]
	},
	"typeCoverage": {
		"#": "needed `any`s",
		"atLeast": 100,
		"detail": true,
		"ignoreCatch": true,
		"ignoreFiles": [
			"lib/index.d.ts"
		],
		"strict": true
	}
}
