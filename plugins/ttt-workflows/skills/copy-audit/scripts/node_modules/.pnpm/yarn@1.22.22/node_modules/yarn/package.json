{
	"name": "yarn",
	"version": "1.22.22",
	"description": "📦🐈 Fast, reliable, and secure dependency management.",
	"license": "BSD-2-Clause",
	"repository": "yarnpkg/yarn",
	"bin": {
		"yarn": "./bin/yarn.js",
		"yarnpkg": "./bin/yarn.js"
	},
	"scripts": {
		"preinstall": ":; (node ./preinstall.js > /dev/null 2>&1 || true)"
	},
	"resolutions": {
		"sshpk": "^1.14.2"
	},
