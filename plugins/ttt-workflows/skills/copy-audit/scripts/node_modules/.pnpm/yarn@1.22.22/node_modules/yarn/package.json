		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"preferGlobal": true,
	"engines": {
		"node": ">=4.0.0"
	},
	"packageManager": "yarn@1.22.17",
	"installationMethod": "tar"
}
